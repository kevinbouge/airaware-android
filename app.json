{
  "expo": {
    "name": "AirAware",
    "slug": "airaware-android",
    "scheme": "airaware",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "eu.euroempire.airaware",
      "permissions": ["ACCESS_COARSE_LOCATION"],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F2F5F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AirAware uses your approximate foreground location to retrieve local environmental conditions."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#45BF75",
          "defaultChannel": "risk-changes"
        }
      ],
      "expo-system-ui",
      "./plugins/withAirAwareAndroidWidgets",
      "expo-localization"
    ]
  }
}
