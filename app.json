{
  "expo": {
    "name": "AirAware",
    "slug": "airaware-android",
    "scheme": "airaware",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "eu.euroempire.airaware",
      "permissions": ["ACCESS_COARSE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#F2F5F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AirAware uses your approximate foreground location to retrieve local environmental conditions."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2F7D46",
          "defaultChannel": "risk-changes"
        }
      ],
      "./plugins/withAirAwareAndroidWidgets"
    ]
  }
}
